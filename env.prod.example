# Gestionnaire de projets - .env du serveur (docker-compose.prod.yml).
# Copier en .env SEULEMENT pour fixer des valeurs : deploy.sh / deploy.ps1
# generent SECRET_KEY et POSTGRES_PASSWORD s'ils sont absents, et deduisent
# le reste de l'adresse LAN. Ne jamais versionner le .env.

# ── Secrets (laisser vides : generes au premier deploiement, puis NE PLUS LES CHANGER) ──
# Mot de passe saisi a la main : sans @ : / # ? %
SECRET_KEY=
POSTGRES_PASSWORD=

# ── Version des images antifragile237/cfao-projets-* ──
PJ_VERSION=v0.1.0

# ── Compte de l'equipe technique (superadmin, journal des erreurs) ──
# Cree au demarrage de l'API s'il manque. Sans ces deux valeurs, aucun compte
# n'est cree. Mot de passe fort et propre au serveur ; change ensuite dans
# l'application, il n'est jamais ecrase.
PJ_COMPTE_TECHNIQUE=
PJ_COMPTE_TECHNIQUE_MDP=

# ── Exposition (par defaut : http://<IP LAN>:8094) ──
#PJ_PORT=8094
#PJ_BIND=0.0.0.0            # 127.0.0.1 si un proxy TLS est devant
#PJ_LAN_HOST=10.68.0.7      # si la detection automatique se trompe
#PJ_PUBLIC_URL=https://projets.example
# Derives de PJ_PUBLIC_URL si absents :
#ORIGINES_AUTORISEES=https://projets.example
#ALLOWED_HOSTS=projets.example
#COOKIE_SECURE=True         # automatique : True si PJ_PUBLIC_URL est en https

# ── Lecture GitHub (jeton lecture seule) et webhook ──
GITHUB_TOKEN=
#GITHUB_WEBHOOK_SECRET=
#SYNCHRO_INTERVALLE=900

# ── Courrier : hub (plateforme), smtp, console ou aucun ──
MAIL_MODE=console
#MAIL_HUB_URL=http://mail-api:8000
#MAIL_HUB_KEY=
#MAIL_SMTP_HOST=
#MAIL_SMTP_PORT=587
#MAIL_SMTP_USER=
#MAIL_SMTP_PASSWORD=
#MAIL_SMTP_TLS=True
#MAIL_FROM=CFAO Academy <helpdeskcm@cfao.com>

# ── Profils des utilisateurs (mode local) ──
#PROFILS_LOCAUX=/donnees/profils-locaux.json
